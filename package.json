{
  "name": "grassigrosso",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:strapi": "npm run develop --prefix strapi-catalog",
    "strapi:sync-seed": "node scripts/sync-strapi-seed.mjs",
    "dev:api": "STRAPI_URL=http://127.0.0.1:1337 PORT=3000 NODE_ENV=development BOT_TOKEN=fake CHAT_ID=123 SMTP_HOST=127.0.0.1 SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=test SMTP_PASS=test MAIL_FROM=test@example.com MAIL_TO=test@example.com DB_PATH=./data/leads-local-strapi-3000.db node server.cjs",
    "dev:all": "concurrently -k -n STRAPI,API,WEB -c yellow,green,blue \"npm:dev:strapi\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:stop": "kill-port 1337 3000 3200 5174",
    "build:web": "vite build",
    "build:strapi": "npm run build --prefix strapi-catalog",
    "build": "npm run build:web && npm run build:strapi",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:routes && npm run check:pages-cms-contract && npm run check:pages-cms-isolation && npm run check:catalog-api && npm run typecheck",
    "check:routes": "node scripts/check-routing-contracts.mjs",
    "check:pages-cms-contract": "node scripts/check-pages-cms-contract.mjs",
    "check:pages-cms-components": "PAGES_CMS_SCHEMA_MODE=components node scripts/check-pages-cms-contract.mjs",
    "check:pages-cms-single-types": "PAGES_CMS_SCHEMA_MODE=single-types node scripts/check-pages-cms-contract.mjs",
    "check:pages-cms-strict": "PAGES_CMS_SCHEMA_MODE=strict node scripts/check-pages-cms-contract.mjs",
    "check:pages-cms-catalog-scope": "node scripts/check-pages-cms-catalog-scope.mjs",
    "check:pages-cms-isolation": "node scripts/check-pages-cms-isolation.mjs",
    "check:pages-cms-hydrate": "node scripts/check-pages-cms-hydrate.mjs",
    "check:pages-cms-hydrate-dom": "node scripts/check-pages-cms-hydrate-dom.mjs",
    "pages:sync-defaults-fixtures": "node scripts/sync-pages-defaults-to-fixtures.mjs",
    "check:pages-cms": "node scripts/check-pages-cms.mjs",
    "check:pages-cms-phase-e": "PAGES_CMS_PHASE_E_FULL=1 node scripts/check-pages-cms.mjs",
    "check:pages-cms-uploads-disk-first": "node scripts/check-pages-cms-uploads-disk-first.mjs",
    "check:pages-cms-live-edit": "node scripts/check-pages-cms-live-edit.mjs",
    "check:pages-cms-degraded-media": "node scripts/check-pages-cms-degraded-media.mjs",
    "check:pages-cms-stack-signal": "node scripts/check-pages-cms-stack-signal.mjs",
    "check:pages-cms-phase-5": "node scripts/check-pages-cms-phase-5.mjs",
    "check:pages-cms-phase-5:record": "node scripts/check-pages-cms-phase-5.mjs --record",
    "check:pages-cms-phase-a": "node scripts/check-pages-cms-phase-a.mjs",
    "check:pages-cms-phase-b": "node scripts/check-pages-cms-phase-b.mjs",
    "check:pages-cms-phase-c": "node scripts/check-pages-cms-phase-c.mjs",
    "check:pages-cms-phase-6b": "node scripts/check-pages-cms-phase-6b.mjs",
    "check:pages-cms-phase-6": "node scripts/check-pages-cms-phase-6.mjs",
    "check:pages-cms-phase-6:record": "node scripts/check-pages-cms-phase-6.mjs --record",
    "check:pages-cms-phase-6c": "node scripts/check-pages-cms-phase-6c.mjs",
    "check:pages-cms-phase-6c-seed": "node scripts/check-pages-cms-phase-6c.mjs --seed-only",
    "check:pages-cms-phase-6d": "node scripts/check-pages-cms-phase-6d.mjs",
    "check:pages-cms-media-integrity": "node scripts/check-pages-cms-media-integrity.mjs",
    "pages-cms:extract-legal-fixtures": "node scripts/pages-cms/extract-legal-fixtures.mjs",
    "pages-cms:check-legal-fixtures": "node scripts/pages-cms/extract-legal-fixtures.mjs --check",
    "pages-cms:generate-legal-ssr": "node scripts/pages-cms/generate-legal-ssr.mjs",
    "pages-cms:check-legal-ssr": "node scripts/pages-cms/generate-legal-ssr.mjs --check",
    "pages-cms:check-legal-parity": "node scripts/pages-cms/legal-ssr-parity.mjs --check",
    "check:pages-api": "node scripts/check-pages-api.mjs",
    "pages:export-snapshot": "node scripts/export-pages-snapshot.mjs",
    "pages-cms:seed": "node scripts/seed-pages-cms-from-fixtures.mjs",
    "pages-cms:seed:preflight": "node scripts/seed-pages-cms-from-fixtures.mjs --preflight-only",
    "preview": "vite preview",
    "new-page": "node scripts/new-page.mjs",
    "start": "bash scripts/start-services.sh",
    "check:catalog-api": "node scripts/check-catalog-api.mjs",
    "check:catalog-ui": "node scripts/check-catalog-ui.mjs",
    "check:catalog-perf": "node scripts/check-catalog-perf.mjs",
    "catalog-import:build": "python3 scripts/build-catalog-import.py",
    "catalog-import:validate": "node scripts/validate-catalog-import.mjs",
    "catalog-import:preview": "node scripts/build-catalog-import-preview.mjs",
    "catalog-import:preview:serve": "node scripts/build-catalog-import-preview.mjs && npx --yes serve docs/catalog-import -p 8765",
    "catalog:optimize-media": "node scripts/optimize-catalog-uploads.mjs",
    "catalog:export-snapshot": "node scripts/export-catalog-snapshot.mjs",
    "catalog-import:strapi": "npm run build --prefix strapi-catalog && node strapi-catalog/scripts/import-catalog-import.cjs && npm run catalog:optimize-media"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "gsap": "^3.14.2",
    "http-proxy-middleware": "^3.0.5",
    "lenis": "^1.3.17",
    "lucide-react": "^1.14.0",
    "nodemailer": "^8.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^7.2.4"
  }
}
