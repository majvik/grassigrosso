{
  "kind": "collectionType",
  "collectionName": "catalog_share_helps",
  "info": {
    "singularName": "catalog-share-help",
    "pluralName": "catalog-share-helps",
    "displayName": "Подсказка к share"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "share_key": {
      "type": "enumeration",
      "enum": ["favouritesShare", "productShare"],
      "required": true,
      "unique": true
    },
    "modal_title": {
      "type": "string",
      "required": true
    },
    "summary_title": {
      "type": "string",
      "default": "Если коротко"
    },
    "summary_items": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.filter-help-summary-item"
    },
    "segments": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.filter-help-segment"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
